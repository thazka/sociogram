# Normalize line endings: LF in the repository, native on checkout.
* text=auto

# Always LF (shaders and scripts are read by tools that do not care, but diffs should be stable).
*.rs text eol=lf
*.wgsl text eol=lf
*.ts text eol=lf
*.mjs text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.md text eol=lf

*.png binary
*.wasm binary
